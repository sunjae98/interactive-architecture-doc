  "scenarios": [
    {
      "id": "simple",
      "label": "단순 응답",
      "icon": "💬",
      "input": "영업시간이 어떻게 되나요?",
      "steps": {
        "1": "POST /v1/ask\n{ \"input\": \"영업시간이 어떻게 되나요?\" }",
        "2": "config = {\n  classifier: \"rules-v2\",\n  timeout_ms: 800,\n  fallback: \"inline\"\n}",
        "3": "route = \"simple\"\nmatched_rule = \"faq.opening_hours\"",
        "4": "faq_handler.answer(\"opening_hours\")\n→ \"평일 09:00–18:00\"",
        "5": "cache.set(\"faq:opening_hours\", answer, ttl = 3600)",
        "6": "{\n  \"status\": \"done\",\n  \"answer\": \"평일 09:00–18:00\",\n  \"links\": []\n}",
        "7": "200 OK — 클라이언트가 답을 바로 표시"
      }
    },
    {
      "id": "lookup",
      "label": "조회 필요",
      "icon": "🔎",
      "input": "지난주에 출고된 주문 찾아줘",
      "steps": {
        "1": "POST /v1/ask\n{ \"input\": \"지난주에 출고된 주문 찾아줘\" }",
        "2": "config = {\n  classifier: \"rules-v2\",\n  timeout_ms: 800,\n  fallback: \"inline\"\n}",
        "3": "route = \"lookup\"\nreason = \"라우터가 갖고 있지 않은 레코드가 필요함\"",
        "4": "GET /search?q=status:shipped+date:last-7d\n→ 42건",
        "5": "summarizer.run(hits[:10])\n→ \"42건 출고, 그중 3건 지연\"",
        "6": "{\n  \"status\": \"done\",\n  \"answer\": \"42건 출고, 그중 3건 지연\",\n  \"links\": [\"/orders?filter=shipped-7d\"]\n}",
        "7": "200 OK — 답변 + 전체 목록 링크"
      }
    },
    {
      "id": "job",
      "label": "오래 걸리는 작업",
      "icon": "⏳",
      "input": "분기 보고서 PDF 만들어줘",
      "steps": {
        "1": "POST /v1/ask\n{ \"input\": \"분기 보고서 PDF 만들어줘\" }",
        "2": "config = {\n  classifier: \"rules-v2\",\n  timeout_ms: 800,\n  fallback: \"inline\"\n}",
        "3": "route = \"job\"\nreason = \"예상 실행 시간 90s > timeout_ms\"",
        "4": "POST /jobs\n{ \"kind\": \"report.quarterly\" }\n→ { \"job_id\": \"j-7f3a\" }",
        "5": "status_store.put(\"j-7f3a\", \"queued\")\nstatus_url = \"/v1/jobs/j-7f3a\"",
        "6": "{\n  \"status\": \"pending\",\n  \"answer\": null,\n  \"links\": [\"/v1/jobs/j-7f3a\"]\n}",
        "7": "202 Accepted — 클라이언트가 status_url을 완료될 때까지 폴링"
      }
    }
  ],
