{
  "meta": {
    "title": "OAuth2 인가 코드 로그인",
    "lang": "ko",
    "intro": "웹 앱이 인가 코드 방식으로 IdP를 거쳐 사용자를 로그인시키는 과정을 보여 드립니다. 시나리오를 고르고 **다음 단계 →**를 누르세요.",
    "facts": [
      {"label":"grant","value":"authorization_code"},
      {"label":"PKCE","value":"S256"},
      {"label":"토큰","value":"서버에만 보관","mono":false}
    ],
    "source": "RFC 6749와 RFC 7636(PKCE)을 바탕으로 한 일반 예시입니다."
  },
  "legend": {
    "nodes": {"client":"사용자 브라우저","app":"우리 웹 앱","dep":"IdP","store":"세션 저장소"},
    "edges": {"file":"대용량 데이터","text":"요청·토큰","ctrl":"리다이렉트·응답"},
    "tokens": [{"kind":"text","text":"code=abc"},{"kind":"err","text":"access_denied"}]
  },
  "nodes": [
    {
      "id": "browser",
      "kind": "client",
      "title": "브라우저",
      "mono": "user agent",
      "sub": ["리다이렉트를 따라감"],
      "facts": ["IdP 쿠키를 가지고 있고 모든 **302**를 따라갑니다.","client secret이나 토큰은 보지 못합니다."]
    },
    {
      "id": "web-app",
      "kind": "app",
      "title": "웹 앱",
      "mono": "/login, /callback",
      "sub": ["기밀 클라이언트"],
      "facts": ["`state`와 PKCE verifier를 만들고, 코드는 백채널로 교환합니다."]
    },
    {
      "id": "authz",
      "kind": "dep",
      "title": "인가 엔드포인트",
      "mono": "GET /authorize",
      "facts": ["사용자를 인증하고 동의를 받습니다."]
    },
    {
      "id": "token",
      "kind": "dep",
      "title": "토큰 엔드포인트",
      "mono": "POST /token",
      "facts": ["일회용 코드를 토큰으로 바꿉니다. client secret과 PKCE verifier가 필요합니다."]
    },
    {
      "id": "userinfo",
      "kind": "dep",
      "title": "사용자 정보 엔드포인트",
      "mono": "GET /userinfo",
      "facts": ["유효한 액세스 토큰에 대한 프로필을 돌려줍니다."]
    },
    {
      "id": "session",
      "kind": "store",
      "title": "세션 저장소",
      "mono": "redis",
      "sub": ["TTL 8시간"],
      "facts": ["세션 쿠키를 사용자와 리프레시 토큰에 연결합니다."]
    }
  ],
  "edges": [
    {"id":"visit","from":"browser","to":"web-app","kind":"text"},
    {"id":"redirect","from":"web-app","to":"authz","kind":"ctrl"},
    {"id":"login","from":"browser","to":"authz","kind":"text"},
    {"id":"code","from":"authz","to":"web-app","kind":"ctrl"},
    {"id":"exchange","from":"web-app","to":"token","kind":"text"},
    {"id":"who","from":"web-app","to":"userinfo","kind":"text"},
    {"id":"save","from":"web-app","to":"session","kind":"text"}
  ],
  "scenarios": [
    {
      "id": "happy",
      "title": "로그인 성공",
      "summary": "브라우저 → IdP → 코드 → 토큰 → 세션",
      "lead": "사용자가 **로그인**을 누르고 IdP에서 인증한 뒤, 앱이 토큰으로 바꿀 일회용 코드를 들고 돌아옵니다.",
      "steps": [
        {
          "title": "사용자가 /login을 엶",
          "edges": ["visit"],
          "token": {"text":"GET /login","kind":"text"},
          "what": "브라우저가 앱에 로그인을 시작해 달라고 요청합니다.",
          "where": "앱 라우트 `/login`.",
          "fail": "앱이 죽어 있으면 502가 뜨고 아무것도 시작되지 않습니다."
        },
        {
          "title": "앱이 IdP로 리다이렉트",
          "edges": ["redirect"],
          "token": {"text":"302 + state","kind":"ctrl"},
          "what": "`client_id`, `state`, PKCE `code_challenge`를 실은 리다이렉트입니다.",
          "where": "`state`와 verifier는 세션에 저장합니다.",
          "fail": "`client_id`가 없으면 IdP가 `invalid_request`를 보여 줍니다."
        },
        {
          "title": "사용자가 로그인하고 동의",
          "edges": ["login"],
          "token": {"text":"자격 증명","kind":"text"},
          "what": "사용자가 비밀번호를 입력하고 요청한 권한을 승인합니다.",
          "where": "IdP에서만 일어납니다. 앱은 비밀번호를 보지 못합니다.",
          "fail": "비밀번호가 틀리면 IdP가 다시 묻고, 앱은 관여하지 않습니다."
        },
        {
          "title": "IdP가 코드를 돌려줌",
          "edges": ["code"],
          "token": {"text":"code=abc","kind":"ctrl"},
          "what": "`/callback?code=...&state=...`로 돌아오는 리다이렉트입니다.",
          "where": "쿼리 문자열, 약 60초 동안 유효합니다.",
          "fail": "`state`가 다르면 앱이 콜백을 거절합니다(CSRF 방지)."
        },
        {
          "title": "앱이 코드를 교환",
          "edges": ["exchange"],
          "token": {"text":"code+verifier","kind":"text"},
          "what": "코드, secret, `code_verifier`를 담은 백채널 POST입니다.",
          "where": "서버 대 서버, 브라우저를 거치지 않습니다.",
          "fail": "만료되었거나 재사용된 코드는 `invalid_grant`이고, 처음부터 다시 해야 합니다."
        },
        {
          "title": "앱이 세션을 저장",
          "edges": ["who","save"],
          "token": {"text":"프로필","kind":"text"},
          "what": "앱이 프로필을 읽고 세션을 저장합니다.",
          "where": "Redis 키 `sess:<id>`, 쿠키는 `HttpOnly; Secure`.",
          "fail": "Redis 장애 시 로그인은 503으로 닫힌 채 실패합니다."
        }
      ]
    },
    {
      "id": "denied",
      "title": "사용자가 동의 거절",
      "summary": "브라우저 → IdP → 오류 리다이렉트",
      "lead": "사용자가 동의 화면에서 **취소**를 누르면 IdP가 오류를 돌려보내고, 앱은 안내 메시지를 보여 줍니다.",
      "steps": [
        {
          "title": "앱이 IdP로 리다이렉트",
          "edges": ["redirect"],
          "token": {"text":"302 + state","kind":"ctrl"},
          "what": "정상 경로와 같은 인가 리다이렉트입니다.",
          "where": "세션에 `state`가 있습니다.",
          "fail": "여기서는 실패할 일이 없습니다."
        },
        {
          "title": "사용자가 거절",
          "edges": ["login"],
          "token": {"text":"취소","kind":"text"},
          "what": "사용자가 요청한 권한을 거부합니다.",
          "where": "IdP 동의 화면.",
          "fail": "없음: 사용자의 선택입니다."
        },
        {
          "title": "IdP가 오류를 돌려줌",
          "edges": ["code"],
          "token": {"text":"access_denied","kind":"err"},
          "what": "`error=access_denied`와 원래 `state`를 실은 리다이렉트입니다.",
          "where": "`/callback`의 쿼리 문자열.",
          "fail": "앱은 `error`를 믿기 전에 `state`부터 확인해야 합니다.",
          "markers": [{"node":"web-app","label":"코드 없음"}]
        }
      ]
    }
  ],
  "tldr": {
    "title": "세 줄 요약",
    "points": [
      "브라우저는 **코드**만 나르고 토큰은 절대 들고 다니지 않습니다.",
      "`state`는 위조된 콜백을, PKCE는 탈취된 코드를 막습니다.",
      "토큰은 HttpOnly 쿠키 뒤의 **세션 저장소**에만 있습니다."
    ]
  }
}
